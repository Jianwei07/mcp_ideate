{
  "name": "secure-mcp-ai-ops",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "contracts"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "start": "bun client/src/host/index.ts",
    "build": "bun run --cwd ../frontend build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun scripts/migrate.ts",
    "lint": "biome lint client server contracts scripts",
    "lint:client": "biome lint client",
    "lint:server": "biome lint server",
    "format": "biome format --write client server contracts scripts",
    "format:check": "biome format client server contracts scripts",
    "typecheck": "bun run typecheck:contracts && bun run typecheck:server && bun run typecheck:client",
    "typecheck:contracts": "tsc -p contracts/tsconfig.json --noEmit",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit",
    "typecheck:client": "tsc -p client/tsconfig.json --noEmit",
    "test": "bun test client/tests server/tests",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun test && bun run build"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.8",
    "typescript": "^5.9.0"
  }
}
